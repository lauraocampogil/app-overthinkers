# Copia este archivo como .env y pega la "Publishable key" de tu proyecto Supabase.
# Sin estas variables la app funciona en modo local (planificador sin IA, sin voz).
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=tu-publishable-o-anon-key

# Opcional: muestra la mascota desde el primer día (para revisar el diseño). Quítalo antes de publicar.
# EXPO_PUBLIC_MASCOT_PREVIEW=1
