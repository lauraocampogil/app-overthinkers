{
  "expo": {
    "name": "Okio",
    "slug": "getgo",
    "scheme": ["getgo", "okio"],
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.unixcreative.getgo",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.unixcreative.getgo",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Usamos el micrófono para que puedas soltar lo que tienes en la cabeza hablando."
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Okio lee la foto o la captura que eliges para sacar tus tareas o comprobar que has terminado una.",
          "cameraPermission": "Okio usa la cámara solo cuando haces una foto para demostrar que has terminado una tarea.",
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Usamos el micrófono para que puedas soltar lo que tienes en la cabeza hablando.",
          "speechRecognitionPermission": "Okio escribe lo que dices mientras hablas para poder ordenar tus tareas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A0A0A"
        }
      ],
      "expo-quick-actions",
      [
        "expo-widgets",
        {
          "enableAndroid": false,
          "widgets": [
            {
              "name": "GetGoWidget",
              "displayName": "Okio",
              "description": "Tu mascota y lo más importante de hoy.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/GetGoWidget.tsx"
              }
            }
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Okio lee tu calendario para saber cuándo estás libre y, si lo activas, añade tu plan como bloques."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
