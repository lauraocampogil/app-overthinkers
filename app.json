{
  "expo": {
    "name": "GetGo",
    "slug": "getgo",
    "scheme": "getgo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.unixcreative.getgo",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.unixcreative.getgo",
      "adaptiveIcon": {
        "backgroundColor": "#F0EDFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Usamos el micrófono para que puedas soltar lo que tienes en la cabeza hablando."
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "GetGo lee la captura que eliges para sacar las tareas de tus mensajes.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Usamos el micrófono para que puedas soltar lo que tienes en la cabeza hablando.",
          "speechRecognitionPermission": "GetGo escribe lo que dices mientras hablas para poder ordenar tus tareas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8A5CFF"
        }
      ],
      "expo-quick-actions",
      [
        "expo-widgets",
        {
          "enableAndroid": false,
          "widgets": [
            {
              "name": "GetGoWidget",
              "displayName": "GetGo",
              "description": "Tu mascota y lo que te queda por hacer hoy.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/GetGoWidget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
